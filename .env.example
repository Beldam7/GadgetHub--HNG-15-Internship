# ====================================================
# GadgetHub Environment Variables
# ====================================================
# Copy this file to .env and fill in your values.
# Never commit your real .env file to version control.

# --- Supabase (Backend & Auth) ---
# These are automatically provisioned in the Bolt environment.
# If setting up manually, get these from your Supabase project dashboard:
# https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key is used ONLY in edge functions (server-side).
# NEVER expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Nodemailer SMTP) ---
# Used in the create-order edge function to send order confirmation emails.
# Works with any SMTP provider (Gmail, Outlook, Amazon SES, Postmark, etc.).
# For Gmail: use smtp.gmail.com, port 587, and an App Password (not your regular password).
# For Amazon SES: use your SES SMTP endpoint, port 587, and IAM SMTP credentials.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=orders@your-domain.com

# --- AI Provider (Shopping Assistant) ---
# Used in the ai-assistant edge function to power the chatbot.
# The chatbot has a built-in fallback if no key is provided.
# Supports OpenAI-compatible APIs.
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini

# --- Store Configuration (Optional) ---
# Used in edge functions for email branding.
STORE_NAME=GadgetHub
